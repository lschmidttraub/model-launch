#!/bin/bash

LOG_DIR="${SLURM_SUBMIT_DIR}/logs/${SLURM_JOB_ID}"
FRAMEWORK="{{ framework }}"
ENVIRONMENT="{{ environment }}"
FRAMEWORK_ARGS="{{ framework_args }}"
PRE_LAUNCH_CMDS="{{ pre_launch_cmds }}"
WORKERS={{ workers }}
NODES_PER_WORKER={{ nodes_per_worker }}
WORKER_PORT={{ worker_port }}
HETGROUP={{ hetgroup }}
USE_ROUTER={{ "true" if use_router else "false" }}
ROUTER_ENVIRONMENT="{{ router_environment }}"
ROUTER_PORT={{ router_port }}
ROUTER_ARGS="{{ router_args }}"
USE_OCF={{ "true" if use_ocf else "false" }}
OCF_BOOTSTRAP_ADDR="{{ ocf_bootstrap_addr }}"
OCF_SERVICE_NAME="{{ ocf_service_name }}"
OCF_SERVICE_PORT={{ ocf_service_port }}

{% raw %}
mkdir -p "${LOG_DIR}"
exec > "${LOG_DIR}/log.out" 2>"${LOG_DIR}/log.err"

# Clear inherited CPU binding from parent Slurm environment (e.g. when submitting from a compute node)
unset SLURM_CPU_BIND SLURM_CPU_BIND_TYPE SLURM_CPU_BIND_LIST SLURM_CPU_BIND_VERBOSE

# Architecture detection
ARCH=$(uname -m)
if [[ "$ARCH" == "aarch64" ]]; then
    echo "Running on ARM64 (aarch64)"
    export SP_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/
    export OCF_BIN=/ocfbin/ocf-arm
elif [[ "$ARCH" == "x86_64" ]]; then
    echo "Running on x86_64"
    export SP_NCCL_SO_PATH=/usr/lib/x86_64-linux-gnu/
    export OCF_BIN=/ocfbin/ocf-amd64
else
    echo "Unknown architecture: $ARCH"
    exit 1
fi

# Node setup: prefer the allocation/component nodelist.
# The outer srun launches a single coordinator task, so SLURM_STEP_NODELIST may
# collapse to one node even though the het-group allocation contains many nodes.
ACTIVE_NODELIST="${SLURM_NODELIST:-${SLURM_JOB_NODELIST:-$SLURM_STEP_NODELIST}}"
COMPONENT_NODELIST_VAR="SLURM_JOB_NODELIST_HET_GROUP_${HETGROUP}"
if [ -n "${!COMPONENT_NODELIST_VAR:-}" ]; then
    ACTIVE_NODELIST="${!COMPONENT_NODELIST_VAR}"
fi
nodes=($(scontrol show hostnames "$ACTIVE_NODELIST"))
TOTAL_NODES=${#nodes[@]}

echo "Total nodes allocated: $TOTAL_NODES"
for i in "${!nodes[@]}"; do
    echo "Node $i: ${nodes[$i]}"
done

# Build the launch command based on framework
case "$FRAMEWORK" in
    sglang)
        FRAMEWORK_ENV_SETUP="export no_proxy=\"0.0.0.0,\$no_proxy\"; export NO_PROXY=\"0.0.0.0,\$NO_PROXY\"; export SGL_ENABLE_JIT_DEEPGEMM=\"false\""
        FRAMEWORK_LAUNCH="python3 -m sglang.launch_server"
        ;;
    vllm)
        FRAMEWORK_ENV_SETUP="export RAY_CGRAPH_get_timeout=1800; export no_proxy=\"0.0.0.0,\$no_proxy\"; export NO_PROXY=\"0.0.0.0,\$NO_PROXY\""
        FRAMEWORK_LAUNCH="python3 -m vllm.entrypoints.openai.api_server"
        ;;
esac

# Router always uses sglang_router (works with any OpenAI-compatible backend)
ROUTER_LAUNCH="python3 -m sglang_router.launch_router"

# Validate configuration
EXPECTED_NODES=$((WORKERS * NODES_PER_WORKER))
if [ $TOTAL_NODES -ne $EXPECTED_NODES ]; then
    echo "Warning: Total nodes ($TOTAL_NODES) doesn't match WORKERS($WORKERS) * NODES_PER_WORKER($NODES_PER_WORKER) = $EXPECTED_NODES"
    echo "Adjusting to use all available nodes with WORKERS workers"
    NODES_PER_WORKER=$((TOTAL_NODES / WORKERS))
fi

# Collect worker head IPs
worker_head_ips=()
worker_urls=()

for worker_id in $(seq 0 $((WORKERS - 1))); do
    start_node=$((worker_id * NODES_PER_WORKER))
    worker_host_node=${nodes[$start_node]}
    # Resolve IP via scontrol (no srun step needed, avoids interconnect issues in hetjobs)
    worker_host_ip=$(scontrol show node "$worker_host_node" | grep -oP 'NodeAddr=\K[^ ]+')

    if [ -z "$worker_host_ip" ]; then
        echo "Error: Could not retrieve IP address for worker $worker_id host ${worker_host_node}"
        exit 1
    fi

    echo "Worker $worker_id host IP: $worker_host_ip"
    worker_head_ips+=("$worker_host_ip")
    worker_urls+=("http://${worker_host_ip}:${WORKER_PORT}")
done

echo "All worker URLs: ${worker_urls[@]}"

# Launch workers
for worker_id in $(seq 0 $((WORKERS - 1))); do
    echo "Launching worker $worker_id"
    start_node=$((worker_id * NODES_PER_WORKER))
    worker_host_ip=${worker_head_ips[$worker_id]}

    if [ "$NODES_PER_WORKER" -eq 1 ]; then
        # Single-node worker: one srun per worker (no inter-node NCCL needed)
        node=${nodes[$start_node]}
        FRAMEWORK_CMD="$FRAMEWORK_LAUNCH $FRAMEWORK_ARGS"

        if [ "$USE_OCF" = "true" ]; then
            FRAMEWORK_CMD="\$OCF_BIN start --bootstrap.addr \"$OCF_BOOTSTRAP_ADDR\" --service.name $OCF_SERVICE_NAME --service.port $OCF_SERVICE_PORT --subprocess \"$FRAMEWORK_CMD\""
        fi

        srun --overlap --het-group=${HETGROUP} --nodes=1 --ntasks=1 --nodelist=$node \
            --container-writable \
            --environment="$ENVIRONMENT" \
            --output=${LOG_DIR}/worker${worker_id}_node0_${node}.out \
            --error=${LOG_DIR}/worker${worker_id}_node0_${node}.err \
            bash --norc --noprofile -c "\
set -ex
$FRAMEWORK_ENV_SETUP
if [ -n \"$PRE_LAUNCH_CMDS\" ]; then
    echo \"Running pre-launch commands...\"
    eval \"$PRE_LAUNCH_CMDS\"
fi
$FRAMEWORK_CMD" &

    elif [ "$FRAMEWORK" = "vllm" ]; then
        # Multi-node vLLM with Ray: per-node srun (Ray uses TCP, not CXI)
        RAY_PORT=6379
        NUM_GPUS=4

        for local_rank in $(seq 0 $((NODES_PER_WORKER - 1))); do
            global_node_idx=$((start_node + local_rank))
            node=${nodes[$global_node_idx]}

            if [ $local_rank -eq 0 ]; then
                FRAMEWORK_CMD="ray start --head --port=${RAY_PORT} --num-gpus=${NUM_GPUS} --block &
RAY_HEAD_PID=\$!

echo 'Waiting for all Ray worker nodes to connect...'
EXPECTED_GPUS=\$((${NODES_PER_WORKER} * ${NUM_GPUS}))
while true; do
    AVAILABLE_GPUS=\$(python3 -c 'import ray; ray.init(address=\"auto\"); print(int(ray.available_resources().get(\"GPU\", 0)))' 2>/dev/null || echo 0)
    echo \"Available GPUs: \${AVAILABLE_GPUS} / \${EXPECTED_GPUS}\"
    if [ \"\${AVAILABLE_GPUS}\" -ge \"\${EXPECTED_GPUS}\" ]; then
        echo 'All Ray workers connected!'
        break
    fi
    sleep 5
done

$FRAMEWORK_LAUNCH --distributed-executor-backend ray $FRAMEWORK_ARGS"
            else
                FRAMEWORK_CMD="ray start --address=${worker_host_ip}:${RAY_PORT} --num-gpus=${NUM_GPUS} --block"
            fi

            if [ "$USE_OCF" = "true" ] && [ $local_rank -eq 0 ]; then
                FRAMEWORK_CMD="\$OCF_BIN start --bootstrap.addr \"$OCF_BOOTSTRAP_ADDR\" --service.name $OCF_SERVICE_NAME --service.port $OCF_SERVICE_PORT --subprocess \"$FRAMEWORK_CMD\""
            fi

            srun --overlap --het-group=${HETGROUP} --nodes=1 --ntasks=1 --nodelist=$node \
                --container-writable \
                --environment="$ENVIRONMENT" \
                --output=${LOG_DIR}/worker${worker_id}_node${local_rank}_${node}.out \
                --error=${LOG_DIR}/worker${worker_id}_node${local_rank}_${node}.err \
                bash --norc --noprofile -c "\
set -ex
$FRAMEWORK_ENV_SETUP
if [ -n \"$PRE_LAUNCH_CMDS\" ]; then
    echo \"Running pre-launch commands...\"
    eval \"$PRE_LAUNCH_CMDS\"
fi
$FRAMEWORK_CMD" &
        done

    else
        # Multi-node (sglang): single srun for all nodes in the worker so they
        # share CXI network credentials for NCCL inter-node communication.
        # Each task determines its node rank via SLURM_NODEID at runtime.
        worker_nodelist=""
        for i in $(seq 0 $((NODES_PER_WORKER - 1))); do
            idx=$((start_node + i))
            [ -n "$worker_nodelist" ] && worker_nodelist="${worker_nodelist},"
            worker_nodelist="${worker_nodelist}${nodes[$idx]}"
        done

        FRAMEWORK_CMD="$FRAMEWORK_LAUNCH --dist-init-addr ${worker_host_ip}:5757 --nnodes ${NODES_PER_WORKER} --node-rank \$SLURM_NODEID $FRAMEWORK_ARGS"

        if [ "$USE_OCF" = "true" ]; then
            FRAMEWORK_CMD="if [ \$SLURM_NODEID -eq 0 ]; then \$OCF_BIN start --bootstrap.addr \"$OCF_BOOTSTRAP_ADDR\" --service.name $OCF_SERVICE_NAME --service.port $OCF_SERVICE_PORT --subprocess \"$FRAMEWORK_LAUNCH --dist-init-addr ${worker_host_ip}:5757 --nnodes ${NODES_PER_WORKER} --node-rank \$SLURM_NODEID $FRAMEWORK_ARGS\"; else $FRAMEWORK_LAUNCH --dist-init-addr ${worker_host_ip}:5757 --nnodes ${NODES_PER_WORKER} --node-rank \$SLURM_NODEID $FRAMEWORK_ARGS; fi"
        fi

        srun --overlap --het-group=${HETGROUP} \
            --nodes=${NODES_PER_WORKER} --ntasks=${NODES_PER_WORKER} --ntasks-per-node=1 \
            --nodelist=${worker_nodelist} \
            --container-writable \
            --environment="$ENVIRONMENT" \
            --output=${LOG_DIR}/worker${worker_id}_node%n_%N.out \
            --error=${LOG_DIR}/worker${worker_id}_node%n_%N.err \
            bash --norc --noprofile -c "\
set -ex
$FRAMEWORK_ENV_SETUP
if [ -n \"$PRE_LAUNCH_CMDS\" ]; then
    echo \"Running pre-launch commands...\"
    eval \"$PRE_LAUNCH_CMDS\"
fi
$FRAMEWORK_CMD" &
    fi
done

# Optional router launch
if [ "$USE_ROUTER" = "true" ] && [ $WORKERS -gt 1 ]; then
    router_host_node=${nodes[0]}
    router_host_ip=${worker_head_ips[0]}

    # Build worker URLs string
    worker_urls_str="${worker_urls[@]}"

    echo "Starting router on ${router_host_node} (${router_host_ip}:${ROUTER_PORT})"
    echo "Router worker URLs: ${worker_urls_str}"

    srun --het-group=${HETGROUP} --nodes=1 --ntasks=1 --cpus-per-task=40 --nodelist=$router_host_node \
        --container-writable \
        --environment="$ROUTER_ENVIRONMENT" \
        --overlap \
        --output=${LOG_DIR}/router_${router_host_node}.out \
        --error=${LOG_DIR}/router_${router_host_node}.err \
        bash --norc --noprofile -c "\
set -ex
# 1. Unconditionally bypass the proxy for the Rust router
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY

echo \"Waiting for all workers to fully initialize the GPU engine before starting router...\"
for worker_ip in ${worker_head_ips[*]}; do
    echo \"Checking worker at \$worker_ip...\"
    while [ \"\$(curl --noproxy \"*\" -s -o /dev/null -w '%{http_code}' http://\${worker_ip}:${WORKER_PORT}/health)\" != \"200\" ]; do
        sleep 10
    done
    echo \"Worker \$worker_ip is fully ready!\"
done
echo \"All workers are ready! Launching router...\"

# 3. Launch the router
$ROUTER_LAUNCH --host 0.0.0.0 --port ${ROUTER_PORT} --worker-urls ${worker_urls_str} $ROUTER_ARGS" &

    echo ""
    echo "Router URL: http://${router_host_ip}:${ROUTER_PORT}"
fi

echo ""
echo "To connect to the host node:"
echo "srun --jobid $SLURM_JOB_ID --het-group=${HETGROUP} -w ${nodes[0]} --overlap --pty bash"

echo ""
echo "Make sure to cancel the job at the end:"
echo "scancel $SLURM_JOB_ID"

wait
echo "Script finished at $(date)"
{% endraw %}
